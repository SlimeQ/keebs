<Window x:Class="Keebs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keebs"
        Width="1220"
        Height="440"
        MinWidth="600"
        MinHeight="245"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowActivated="False"
        Topmost="True"
        Icon="Assets/keebs.ico"
        Background="#101217">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelStrokeBrush" Color="#343B48" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7FAFF" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#A7B1C0" />
        <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#272C36" Offset="0" />
            <GradientStop Color="#171A21" Offset="0.58" />
            <GradientStop Color="#101217" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeyboardDeckBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#222733" Offset="0" />
            <GradientStop Color="#151922" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeyFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B4352" Offset="0" />
            <GradientStop Color="#252B36" Offset="0.54" />
            <GradientStop Color="#1D222B" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeyHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#465163" Offset="0" />
            <GradientStop Color="#303846" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeyPressedBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1F2530" Offset="0" />
            <GradientStop Color="#303847" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SuggestionFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#27556C" Offset="0" />
            <GradientStop Color="#1A3849" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UtilityFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A3F52" Offset="0" />
            <GradientStop Color="#2E2936" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="KeyboardButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=KeyFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource KeyFaceBrush}" />
            <Setter Property="BorderBrush" Value="#566171" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border Margin="0,2,0,0"
                                    CornerRadius="8"
                                    Background="#0A0C10"
                                    Opacity="0.62" />
                            <Border x:Name="KeyChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Border Height="10"
                                            VerticalAlignment="Top"
                                            Margin="1"
                                            CornerRadius="7,7,3,3"
                                            Background="#FFFFFF"
                                            Opacity="0.06" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="1,0"
                                                      RecognizesAccessKey="False" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ActualHeight" Value="0">
                                <Setter Property="MinHeight" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource KeyHoverBrush}" />
                                <Setter TargetName="KeyChrome" Property="BorderBrush" Value="#728094" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource KeyPressedBrush}" />
                                <Setter TargetName="KeyChrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionButton" TargetType="Button" BasedOn="{StaticResource KeyboardButton}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{StaticResource SuggestionFaceBrush}" />
            <Setter Property="BorderBrush" Value="#4D8AA6" />
        </Style>

        <Style x:Key="UtilityButton" TargetType="Button" BasedOn="{StaticResource KeyboardButton}">
            <Setter Property="Background" Value="{StaticResource UtilityFaceBrush}" />
            <Setter Property="BorderBrush" Value="#6B5F77" />
        </Style>

        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource UtilityButton}">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack"
                                    Width="38"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#202631"
                                    BorderBrush="#4B5565"
                                    BorderThickness="1">
                                <Border x:Name="SwitchThumb"
                                        Width="14"
                                        Height="14"
                                        Margin="3,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="7"
                                        Background="#C9D2DE" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="7,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#3A5365" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#6E9AB3" />
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#E8F7FF" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OuterMargin}"
            Padding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShellPadding}"
            CornerRadius="14"
            Background="{StaticResource ShellBrush}"
            BorderBrush="{StaticResource PanelStrokeBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.34"
                              ShadowDepth="8"
                              Color="#050608" />
        </Border.Effect>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,6">
            <ItemsControl x:Name="SuggestionStrip">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SuggestionButton}"
                                Content="{Binding}"
                                Click="Suggestion_Click" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="1"
                Padding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DeckPadding}"
                CornerRadius="12"
                Background="{StaticResource KeyboardDeckBrush}"
                BorderBrush="#2F3744"
                BorderThickness="1">
        <Grid x:Name="KeyboardGrid">
        </Grid>
        </Border>

        <Grid x:Name="FooterBar" Grid.Row="2" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="PredictionToggle"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="4,0,8,0"
                      FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                      Content="Predict"
                      IsChecked="True"
                      Checked="Prediction_Changed"
                      Unchecked="Prediction_Changed" />

            <CheckBox x:Name="LearningToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="4,0,10,0"
                      FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                      Content="Learn"
                      IsChecked="True"
                      Checked="Learning_Changed"
                      Unchecked="Learning_Changed" />

            <Border Grid.Column="2"
                    Margin="0,1,10,1"
                    Padding="8,0"
                    MinWidth="126"
                    CornerRadius="9"
                    Background="#202631"
                    BorderBrush="#455061"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusDotSize}"
                             Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusDotSize}"
                             Fill="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusAccentBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="PrivacyStatus"
                               Grid.Column="1"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                               Foreground="#D1D8E2"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"
                               Text="Predictions on" />
                </Grid>
            </Border>

            <Button x:Name="UpdateButton"
                    Grid.Column="3"
                    Style="{StaticResource FooterButton}"
                    Margin="0,0,10,0"
                    FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                    Content="Update"
                    ToolTip="Check for updates"
                    Click="Update_Click" />

            <TextBlock Grid.Column="4"
                       x:Name="FooterHint"
                       VerticalAlignment="Center"
                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FooterHintText}" />
        </Grid>
    </Grid>
    </Border>
</Window>
