<Window x:Class="Keebs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keebs"
        Width="600"
        Height="245"
        MinWidth="600"
        MinHeight="245"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowActivated="False"
        Topmost="True"
        Icon="Assets/keebs.ico"
        Background="#090B0E">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelStrokeBrush" Color="#4A503F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#D2A85F" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EFE6CF" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#A7A68F" />
        <ImageBrush x:Key="ChassisTextureBrush"
                    ImageSource="Assets/chassis-topography-v2.png"
                    Stretch="UniformToFill"
                    AlignmentX="Center"
                    AlignmentY="Center" />
        <LinearGradientBrush x:Key="ShellBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#701B211A" Offset="0" />
            <GradientStop Color="#88131713" Offset="0.34" />
            <GradientStop Color="#A00B0E0C" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeyboardDeckBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#80080B09" Offset="0" />
            <GradientStop Color="#A8131713" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeyFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E7DFC8" Offset="0" />
            <GradientStop Color="#D1C7AA" Offset="0.18" />
            <GradientStop Color="#B8AE91" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UtilityFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#415445" Offset="0" />
            <GradientStop Color="#29392F" Offset="0.2" />
            <GradientStop Color="#1C2A22" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentKeyFaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#743C3A" Offset="0" />
            <GradientStop Color="#562A2C" Offset="0.22" />
            <GradientStop Color="#351B1E" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="KeyboardButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Margin" Value="1.5" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed, Segoe UI" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=KeyFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#182019" />
            <Setter Property="Background" Value="{StaticResource KeyFaceBrush}" />
            <Setter Property="BorderBrush" Value="#EEE5CC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextElement.FontWeight" Value="Bold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border Margin="0,1,0,0"
                                    CornerRadius="3"
                                    Background="#050608" />
                            <Border x:Name="KeyChrome"
                                    Margin="0,0,0,1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <Border Height="1"
                                            VerticalAlignment="Top"
                                            Margin="2,1,2,0"
                                            Background="#FFFFFF"
                                            Opacity="0.32" />
                                    <Border x:Name="KeyInteractionWash"
                                            Margin="1"
                                            Background="#FFFFFF"
                                            Opacity="0" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="1,1,1,0"
                                                      RecognizesAccessKey="False" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ActualHeight" Value="0">
                                <Setter Property="MinHeight" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyInteractionWash" Property="Opacity" Value="0.12" />
                                <Setter TargetName="KeyChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyInteractionWash" Property="Background" Value="#000000" />
                                <Setter TargetName="KeyInteractionWash" Property="Opacity" Value="0.2" />
                                <Setter TargetName="KeyChrome" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=KeyFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="SuggestionHover" Background="{TemplateBinding Background}" />
                            <Border x:Name="SuggestionAccent"
                                    Height="2"
                                    Margin="8,0"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource AccentBrush}"
                                    Opacity="0.45" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SuggestionHover" Property="Background" Value="#243026" />
                                <Setter TargetName="SuggestionAccent" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SuggestionHover" Property="Background" Value="#191F1A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UtilityButton" TargetType="Button" BasedOn="{StaticResource KeyboardButton}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource UtilityFaceBrush}" />
            <Setter Property="BorderBrush" Value="#607260" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource KeyboardButton}">
            <Setter Property="Foreground" Value="#F4E4CB" />
            <Setter Property="Background" Value="{StaticResource AccentKeyFaceBrush}" />
            <Setter Property="BorderBrush" Value="#8E514C" />
        </Style>

        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#1C251F" />
            <Setter Property="BorderBrush" Value="#465647" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Background" Value="#2B392F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#111713" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource FooterButton}">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#687069" />
            <Setter Property="Background" Value="#171B18" />
            <Setter Property="BorderBrush" Value="#343B35" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Available">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="Background" Value="#623536" />
                    <Setter Property="BorderBrush" Value="#8E514C" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack"
                                    Width="14"
                                    Height="14"
                                    CornerRadius="2"
                                    Background="#101510"
                                    BorderBrush="#536054"
                                    BorderThickness="1">
                                <Border x:Name="SwitchThumb"
                                        Width="6"
                                        Height="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="1"
                                        Background="#5F685D" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="5,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#2A382C" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Chassis"
            Margin="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=OuterMargin}"
            Padding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ShellPadding}"
            CornerRadius="8"
            Background="#10140F"
            BorderBrush="{StaticResource PanelStrokeBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            PreviewMouseLeftButtonDown="Chassis_PreviewMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              Direction="270"
                              Opacity="0.34"
                              ShadowDepth="4"
                              Color="#050608" />
        </Border.Effect>

    <Grid>
        <Border CornerRadius="7"
                Background="{StaticResource ChassisTextureBrush}"
                Opacity="0.92" />
        <Border CornerRadius="7"
                Background="{StaticResource ShellBrush}" />

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar"
                Grid.Row="0"
                Margin="0,0,0,6"
                Padding="1,0,1,2"
                Background="Transparent"
                BorderBrush="#8057654F"
                BorderThickness="0,0,0,1">
            <ItemsControl x:Name="SuggestionStrip">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SuggestionButton}"
                                Content="{Binding}"
                                Click="Suggestion_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove from suggestions"
                                              Click="RemoveSuggestion_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border x:Name="KeyboardDeck"
                Grid.Row="1"
                VerticalAlignment="Top"
                Padding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DeckPadding}"
                Background="Transparent"
                BorderThickness="0">
            <Grid>
                <Grid x:Name="KeyboardGrid" />
                <Canvas x:Name="SwipeTrail"
                        ClipToBounds="True"
                        IsHitTestVisible="False">
                    <Polyline x:Name="SwipeTrailLine"
                              Stroke="#D8B46E"
                              StrokeThickness="5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Opacity="0" />
                </Canvas>
            </Grid>
        </Border>

        <Border x:Name="FooterBar"
                Grid.Row="2"
                Margin="0,7,0,0"
                Padding="2,3,2,0"
                Background="Transparent"
                BorderBrush="#8057654F"
                BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="PredictionToggle"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="3,0,8,0"
                      FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                      Content="Predict"
                      IsChecked="True"
                      Checked="Prediction_Changed"
                      Unchecked="Prediction_Changed" />

            <CheckBox x:Name="LearningToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="3,0,10,0"
                      FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                      Content="Learn"
                      IsChecked="True"
                      Checked="Learning_Changed"
                      Unchecked="Learning_Changed" />

            <Border Grid.Column="2"
                    Margin="0,1,10,1"
                    Padding="7,0"
                    MinWidth="120"
                    Background="Transparent"
                    BorderBrush="#8057654F"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusDotSize}"
                             Height="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusDotSize}"
                             Fill="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusAccentBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="PrivacyStatus"
                               Grid.Column="1"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                               Foreground="#DCD6C2"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"
                               Text="Predictions on" />
                </Grid>
            </Border>

            <StackPanel x:Name="UpdateCluster"
                        Grid.Column="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="VersionLabel"
                           Margin="0,0,5,0"
                           VerticalAlignment="Center"
                           FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                           FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                           Foreground="{StaticResource TextMutedBrush}"
                           Opacity="0.82" />
                <Button x:Name="UpdateButton"
                        Style="{StaticResource UpdateButtonStyle}"
                        HorizontalAlignment="Right"
                        FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                        Content="↑"
                        ToolTip="Check for updates"
                        Click="Update_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CheckForUpdatesNowMenuItem"
                                      Header="Check for updates now"
                                      Click="CheckForUpdatesNow_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <Button x:Name="TypingTestButton"
                    Grid.Column="3"
                    Style="{StaticResource FooterButton}"
                    Margin="0,0,8,0"
                    FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                    Content="Test"
                    ToolTip="Open typing-run harness"
                    Click="TypingTest_Click" />

            <TextBlock Grid.Column="4"
                       x:Name="FooterHint"
                       VerticalAlignment="Center"
                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=StatusFontSize}"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FooterHintText}" />
        </Grid>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
