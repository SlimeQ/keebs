<Window x:Class="Keebs.TypingTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keebs typing run"
        Width="720"
        Height="360"
        MinWidth="520"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#101217">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelStrokeBrush" Color="#343B48" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7FAFF" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#A7B1C0" />
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#222733" Offset="0" />
            <GradientStop Color="#151922" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Padding="12"
            CornerRadius="10"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelStrokeBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PromptText"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PromptCounter"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           VerticalAlignment="Top"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Grid>

            <TextBox x:Name="InputBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10"
                     FontSize="20"
                     FontFamily="Segoe UI Variable Text, Segoe UI"
                     Background="#10141B"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="#455061"
                     BorderThickness="1"
                     TextChanged="InputBox_TextChanged" />

            <UniformGrid Grid.Row="2" Columns="4" Margin="0,10,0,8">
                <TextBlock x:Name="WpmText"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="15" />
                <TextBlock x:Name="AccuracyText"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="15" />
                <TextBlock x:Name="ErrorsText"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="15" />
                <TextBlock x:Name="ElapsedText"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="15" />
            </UniformGrid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Margin="0,0,8,0"
                        Content="Finish"
                        Click="Finish_Click" />
                <Button Grid.Column="1"
                        Margin="0,0,8,0"
                        Content="Next"
                        Click="Next_Click" />
                <Button Grid.Column="2"
                        Margin="0,0,12,0"
                        Content="Open data"
                        Click="OpenData_Click" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Border>
</Window>
