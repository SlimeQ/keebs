<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\keebs.ico</ApplicationIcon>
    <AssemblyName>Keebs</AssemblyName>
    <Product>Keebs</Product>
    <Description>Windows on-screen keyboard with local predictions</Description>
    <Company>Keebs</Company>
    <Version>0.1.35</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\keebs.ico" />
    <Resource Include="Assets\chassis-topography-v2.png" />
    <EmbeddedResource Include="Assets\english-common-words.txt" />
    <EmbeddedResource Include="Assets\english-dictionary-words.txt" />
    <EmbeddedResource Include="Assets\pretrain-corpus.txt" />
  </ItemGroup>

</Project>
